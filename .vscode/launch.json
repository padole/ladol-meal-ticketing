{
  // Run and Debug panel (Ctrl+Shift+D). "Full stack" starts both servers with breakpoints enabled.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: Flask",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "env": { "FLASK_APP": "run.py", "FLASK_DEBUG": "1" },
      "args": ["run", "--host", "127.0.0.1", "--port", "5000", "--no-debugger"],
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Frontend: Vite",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "command": "npm run dev"
    },
    {
      "name": "Frontend: open in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "Full stack",
      "configurations": ["Backend: Flask", "Frontend: Vite"],
      "stopAll": true
    }
  ]
}
