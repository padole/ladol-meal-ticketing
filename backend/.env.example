# Copy this file to .env and fill in your local MySQL details.

FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ladol_meal_ticketing

# Optional: a full SQLAlchemy URL overrides the MYSQL_* values above
# DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/ladol_meal_ticketing

# Administrator account created by `flask --app run seed` (log in with this employee no.)
ADMIN_EMPLOYEE_NO=ADMIN
ADMIN_PASSWORD=admin123

# Frontend dev server allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Lock an account for a few minutes after too many wrong passwords
LOGIN_MAX_ATTEMPTS=3
LOGIN_LOCK_MINUTES=5
